{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "description": "Shared settings across all presets",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "QIANJS_BUILD_TESTS": true
      }
    },
    {
      "name": "release",
      "hidden": true,
      "inherits": "common",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QIANJS_BUILD_TESTS": false
      }
    },
    {
      "name": "dev",
      "description": "Default development preset (Debug + tests + desktop profile)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "QIANJS_PROFILE": "desktop"
      }
    },
    {
      "name": "prod",
      "description": "Production build (Release, desktop profile, no tests)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "QIANJS_PROFILE": "desktop"
      }
    },
    {
      "name": "test",
      "description": "Release build with tests (desktop profile)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "QIANJS_BUILD_TESTS": true,
        "QIANJS_PROFILE": "desktop"
      },
      "warnings": {
        "dev": true,
        "deprecated": true,
        "uninitialized": true,
        "unusedCli": false
      }
    },
    {
      "name": "minimal",
      "description": "Minimal profile: console + process only",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-minimal",
      "cacheVariables": {
        "QIANJS_PROFILE": "minimal"
      }
    },
    {
      "name": "io",
      "description": "I/O profile: console, process, timers, fs",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-io",
      "cacheVariables": {
        "QIANJS_PROFILE": "io"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "prod",
      "configurePreset": "prod",
      "jobs": 0,
      "targets": ["qianjs"]
    },
    {
      "name": "test",
      "configurePreset": "test",
      "jobs": 0
    },
    {
      "name": "minimal",
      "configurePreset": "minimal",
      "jobs": 0
    },
    {
      "name": "io",
      "configurePreset": "io",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "io",
      "configurePreset": "io",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
